{
    "name": "vikramsra/laravel-zeptomail",
    "description": "Zoho ZeptoMail mail transport for Laravel",
    "type": "library",
    "keywords": [
        "ZeptoMail",
        "ZOHO",
        "email",
        "transactional",
        "laravel",
        "mail-driver"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Vikramjeet Singh Sra",
            "email": "vikramjeet.sra@gmail.com"
        },
        {
            "name": "Zoho Mail",
            "email": "zmintegration@zohomail.com",
            "role": "Original author"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.2",
        "illuminate/mail": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "symfony/mailer": "^6.0 || ^7.0 || ^8.0",
        "symfony/mime": "^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0",
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ZohoMail\\LaravelZeptoMail\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZohoMail\\LaravelZeptoMail\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZohoMail\\LaravelZeptoMail\\LaravelDriverServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
